  {
   "id": "venta_neta",
   "labelEs": "Venta neta",
   "definicionEs": "Venta devengada: cuenta el día en que se hizo la venta, aunque haya quedado en cuenta corriente (devengado). Venta neta: se restan devoluciones sólo por sucursal y tiempo. Es distinta de Ventas › Totales, que cuenta lo cobrado en caja.",
   "formato": "moneda",
   "bloqueada": false,
   "bloqueos": []
  },
  {
   "id": "unidades",
   "labelEs": "Unidades",
   "definicionEs": "Cantidad de unidades vendidas.",
   "formato": "entero",
   "bloqueada": false,
   "bloqueos": [
    {
     "granos": [
      "pago"
     ],
     "motivoEs": "Las unidades no se pueden repartir por medio de pago."
    }
   ]
  },
  {
   "id": "tickets",
   "labelEs": "Tickets",
   "definicionEs": "Cantidad de ventas (tickets) distintas.",
