    {
     "granos": [
      "item"
     ],
     "motivoEs": "Con agrupaciones por producto, color o talle un ticket aparece en varias filas."
    }
   ]
  },
  {
   "id": "aur",
   "labelEs": "Precio por unidad",
   "definicionEs": "venta ÷ unidades",
   "formato": "moneda",
   "bloqueada": false,
   "bloqueos": [
    {
     "granos": [
      "pago"
     ],
     "motivoEs": "Las unidades no se pueden repartir por medio de pago."
    }
