   "bloqueada": false,
   "bloqueos": [
    {
     "granos": [
      "pago"
     ],
     "motivoEs": "Un ticket puede tener varios medios de pago; se contaría más de una vez."
    }
   ]
  },
  {
   "id": "ticket_promedio",
   "labelEs": "Promedio por ticket",
