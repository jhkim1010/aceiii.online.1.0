# =============================================================================
# vw-agent 환경변수 템플릿
# -----------------------------------------------------------------------------
# 실제 값은 `.env` 파일에 저장하세요 (`.env` 는 .gitignore 에 포함되어 있음).
# 이 `.env.example` 은 Git 에 커밋되며 값 예시만 담습니다.
# =============================================================================

# ---------- 런타임 ----------
NODE_ENV=production
PORT=5999

# ---------- 모니터링 대상 로그 (api_ventago 컨테이너) ----------
# vw-agent 는 `docker exec api_ventago tail -F` 로 로그를 스트림한다.
# api_ventago 에 bind-mount 가 없어서 host 파일시스템으로는 접근 불가.
# 로컬 dev 에서 api_ventago 가 없으면 빈 값으로 두면 LogTail 자동 비활성화.
API_VENTAGO_CONTAINER=api_ventago
# 컨테이너 내부 로그 파일 경로 패턴 (YYYY-MM-DD 는 런타임에 오늘 날짜로 치환)
API_VENTAGO_LOG_PATTERN=/app/logs/combined-YYYY-MM-DD.log

# ---------- PostgreSQL (감시 전용 read-only 계정) ----------
# 로컬 개발: localhost (Mac PG18, 5432), 운영: host.docker.internal (호스트 PG10, 5433)
# 운영서버 구성: 5432 = pgbouncer (다점포 라우팅 전용), 5433 = 호스트 PG10 직접 접속
# vw-agent 는 pgbouncer 우회 — application_name 등 세션 메타데이터 정확 관측 위해
PG_HOST=host.docker.internal
PG_PORT=5433
PG_DATABASE=ventago
PG_WATCHER_USER=ventago_watcher
# openssl rand -base64 32  명령 결과를 붙여넣으세요
PG_WATCHER_PASSWORD=change_me_please_openssl_rand_base64_32

# ---------- Docker socket ----------
DOCKER_SOCKET_PATH=/var/run/docker.sock
# 모니터링 대상 컨테이너 이름 prefix (콤마 구분, 빈값이면 전체)
# 예: "api_ventago,ventago_app,dbpostgres,ventago_minio"
DOCKER_MONITOR_PREFIXES=

# ---------- Telegram Bot ----------
# @BotFather 에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=000000000:AA_EXAMPLE_TOKEN_REPLACE_ME
# 본인 chat_id (getUpdates 응답의 chat.id 숫자)
TELEGRAM_CHAT_ID=000000000

# ---------- SQLite ----------
SQLITE_PATH=/app/data/vw-agent.db

# ---------- 임계치 ----------
# PG 활성 connection 임계치
# 2026-04-22 운영 점검 결과: 기준선 175 (idle 169 + active 1 + idle-in-tx 5) / max_connections=400
# 기존 pool 누수 정상화 전까지 노이즈 차단 목적으로 WARN=250, CRIT=320 적용
# 누수 진단 완료 후 기준선 재평가 예정 (태스크 #7 참조)
THRESHOLD_PG_ACTIVE_WARN=250
THRESHOLD_PG_ACTIVE_CRIT=320
# 디스크 사용률 (%) — 400GB 기준 80%=320GB, 90%=360GB
THRESHOLD_DISK_WARN_PERCENT=80
THRESHOLD_DISK_CRIT_PERCENT=90
# BranchAgent offline 판정 (마지막 heartbeat 이후 경과 분)
THRESHOLD_AGENT_OFFLINE_MINUTES=5

# ---------- 루프 주기 (초/분) ----------
PG_POLL_INTERVAL_SEC=30
DOCKER_POLL_INTERVAL_SEC=60
AGENT_POLL_INTERVAL_SEC=60
# HEARTBEAT_INTERVAL_MIN 은 2026-04-23 부터 사용 안 함
# Heartbeat 은 @Cron 으로 매일 한국시간(KST) 09:00 정각 1회 송신 (하드코딩).
# schema 호환을 위해 값은 남겨두되 실제 동작엔 영향 없음.
HEARTBEAT_INTERVAL_MIN=30

# ---------- 중복 알림 억제 (분) ----------
DEDUP_WINDOW_MINUTES=15

# ---------- 규칙 on/off 플래그 ----------
# RULE-07 (프린터 에이전트 offline 감시) — 2026-04-22 영구 비활성 결정
# 사유: 프린터 운영은 watcher 운영자 책임 밖 + 등록만 되고 실제로는 쓰이지 않는
# 유령 에이전트가 다수라 알림 가치 없음. 향후 branch_agents.is_monitored
# 플래그 도입 시 재활성 가능. 운영 배포 시에는 반드시 false 유지.
RULE_07_ENABLED=false

# ---------- Docker Compose 전용 (런타임 env 아님) ----------
# 운영 서버의 docker 그룹 GID — `getent group docker | cut -d: -f3` 로 확인
# 운영 서버(srv803182, 2026-04-22 확인): 988
DOCKER_GID=988
