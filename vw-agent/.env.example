# =============================================================================
# vw-agent 환경변수 템플릿
# -----------------------------------------------------------------------------
# 실제 값은 `.env` 파일에 저장하세요 (`.env` 는 .gitignore 에 포함되어 있음).
# 이 `.env.example` 은 Git 에 커밋되며 값 예시만 담습니다.
# =============================================================================

# ---------- 런타임 ----------
NODE_ENV=production
PORT=5999

# ---------- 모니터링 대상 로그 ----------
# 로컬 개발: /Users/marcoskim/Trabajos_Programming/ACE_online_1.0/api-ventago/logs
# 운영 Docker: /app/api-logs  (docker-compose 에서 bind-mount)
API_LOG_DIR=/app/api-logs

# ---------- PostgreSQL (감시 전용 read-only 계정) ----------
# 로컬 개발: localhost (dev DB 로 접근), 운영: host.docker.internal (호스트 PG 로)
PG_HOST=host.docker.internal
PG_PORT=5432
PG_DATABASE=ventago
PG_WATCHER_USER=ventago_watcher
# openssl rand -base64 32  명령 결과를 붙여넣으세요
PG_WATCHER_PASSWORD=change_me_please_openssl_rand_base64_32

# ---------- Docker socket ----------
DOCKER_SOCKET_PATH=/var/run/docker.sock
# 모니터링 대상 컨테이너 이름 prefix (콤마 구분, 빈값이면 전체)
# 예: "api_ventago,ventago_app,dbpostgres,ventago_minio"
DOCKER_MONITOR_PREFIXES=

# ---------- Telegram Bot ----------
# @BotFather 에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=000000000:AA_EXAMPLE_TOKEN_REPLACE_ME
# 본인 chat_id (getUpdates 응답의 chat.id 숫자)
TELEGRAM_CHAT_ID=000000000

# ---------- SQLite ----------
SQLITE_PATH=/app/data/vw-agent.db

# ---------- 임계치 ----------
# PG 활성 connection (현재 기준선 34 → WARN=150, CRIT=200 는 보수적)
THRESHOLD_PG_ACTIVE_WARN=150
THRESHOLD_PG_ACTIVE_CRIT=200
# 디스크 사용률 (%) — 400GB 기준 80%=320GB, 90%=360GB
THRESHOLD_DISK_WARN_PERCENT=80
THRESHOLD_DISK_CRIT_PERCENT=90
# BranchAgent offline 판정 (마지막 heartbeat 이후 경과 분)
THRESHOLD_AGENT_OFFLINE_MINUTES=5

# ---------- 루프 주기 (초/분) ----------
PG_POLL_INTERVAL_SEC=30
DOCKER_POLL_INTERVAL_SEC=60
AGENT_POLL_INTERVAL_SEC=60
HEARTBEAT_INTERVAL_MIN=30

# ---------- 중복 알림 억제 (분) ----------
DEDUP_WINDOW_MINUTES=15
