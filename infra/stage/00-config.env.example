# ============================================================
# 스테이지 서버 프로비저닝 설정
# ============================================================
# 사용법:
#   cp 00-config.env.example 00-config.env
#   vi 00-config.env         # 아래 CHANGE_ME 를 전부 채운다
#   chmod 600 00-config.env
#
# ★ 00-config.env 는 .gitignore 대상이다. 절대 커밋하지 않는다.
# ============================================================

# ── 스테이지 서버 ─────────────────────────────────────────
# IONOS VPS 4-8-240 : 4 vCore / 8GB RAM / 240GB NVMe SSD (US)
# ★ IONOS 콘솔의 Cloud Firewall('My firewall policy') 에서 22/80/443 인바운드를
#   먼저 허용해야 한다. ufw 만 열면 06-nginx-ssl.sh 의 certbot 이 실패한다.
STAGE_HOST=74.208.60.137
STAGE_SSH_USER=root
STAGE_SSH_PORT=22
STAGE_TZ=America/Argentina/Buenos_Aires
STAGE_DEPLOY_USER=jhkim                # 운영과 동일한 배포 유저명

# ── 도메인 (DNS A 레코드를 STAGE_HOST 로 미리 걸어둘 것) ──
# 스테이지에서는 ventago 만 테스트한다 → 도메인 2개면 충분하다.
#   · tienda-app / despacho-app / mobile-sales-app / ventago-admin-app 등은 배포하지 않는다
#   · MinIO 는 자체 도메인이 필요 없다. 프론트가 이미지 URL 을
#     {API_HOST}/minio/{fileName} 로 만들어 API 를 경유하기 때문이다.
DOMAIN_APP=stage.coolsistema.com        # ventago-app  (프론트)
DOMAIN_API=stageapi.coolsistema.com     # api-ventago  (백엔드)
DOMAIN_MINIO=                           # 비워둔다 (06 이 자동으로 스킵)
LETSENCRYPT_EMAIL=junghokim10@gmail.com

# ── 운영 서버 (덤프 소스 · 읽기 전용으로만 접근) ───────────
PROD_SSH_ALIAS=jhkim-server            # ~/.ssh/config alias
PROD_PG_PORT=5434                      # 운영 PG18 클러스터 ventago18
PROD_DB_NAME=ventago
PROD_DB_OWNER=coolsistema

# ── 스테이지 DB ───────────────────────────────────────────
STAGE_PG_VERSION=18
STAGE_PG_PORT=5434                     # 운영과 동일 구조 유지 (앱은 pgbouncer 경유)
STAGE_PGB_PORT=5432                    # pgbouncer (앱이 붙는 포트)
STAGE_DB_NAME=ventago
STAGE_DB_OWNER=coolsistema
STAGE_DB_OWNER_PASSWORD=CHANGE_ME_strong_password
STAGE_SHOP_RO_PASSWORD=CHANGE_ME_strong_password

# ── 커넥션 예산 (pool 낭비 방지 — 아래 산식을 지킬 것) ─────
#   앱 클라이언트 상한 = API_REPLICA_COUNT × API_WORKERS × SEQUELIZE_POOL_MAX
#   pgbouncer 백엔드   = pool_size 의 (db, user) 쌍별 합
#   조건: 백엔드 ≤ max_connections × 70%,  그리고 클라이언트 ≈ 백엔드
#
#   ★ 이 서버는 4 vCore / 8GB 한 대에 PG·API·Next.js·Redis·MinIO 가 전부 올라간다.
#     커넥션을 크게 잡을 이유가 없다. 커넥션 하나당 PG 백엔드 프로세스가 뜨고
#     work_mem 이 곱해지므로, 남는 슬롯은 곧 메모리 낭비다.
#
#   현재값:  클라이언트 1×2×8 = 16  /  백엔드 12+4 = 16  /  max_conn 60 (70% = 42)
API_WORKERS=2                          # 4 vCore 중 2개. 나머지는 PG·nginx·빌드 몫

# ★ SEQUELIZE_POOL_MAX 는 **읽기 전용 표기값**이다.
#   실제 값은 api-ventago/src/database/database.module.ts 에 `max: 20` 으로
#   하드코딩돼 있고 env 로 바꿀 수 없다. 여기 숫자를 고쳐도 앱은 20 을 쓴다.
#   → 예산 계산이 현실과 맞도록 코드값(20)을 그대로 적는다.
#   낮추려면 코드 변경이 필요하고, 그건 운영에도 영향을 주는 별도 결정이다.
SEQUELIZE_POOL_MAX=20
API_REPLICA_COUNT=1

# 공개몰(shop_readonly) pool — ventago 만 테스트하므로 최소값.
# SHOP_DB_ISOLATED=false 이면 앱이 min(값, 5) 로 깎는다.
SHOP_DB_POOL_MAX=2

# pgbouncer 서버측 상한 (db, user 쌍별)
#   앱 클라이언트 = 1 × 2 × (20 + 2) = 44
#   백엔드        = 16 + 2 = 18   (44/18 ≈ 2.4:1 — transaction pooling 정상 범위)
#   PG 상한 60 의 70% = 42 ≥ 18 ✓
PGBOUNCER_POOL_SIZE=16                 # (ventago, coolsistema). 운영은 50
PGBOUNCER_SHOP_POOL_SIZE=2             # (ventago, shop_readonly)
PG_MAX_CONNECTIONS=60                  # 운영은 200. 8GB 에서 100 은 과다

# ── 앱 포트 ───────────────────────────────────────────────
API_PORT=5002
APP_PORT=5001

# ── 시크릿 (전부 스테이지 전용으로 새로 생성 — 운영 값 재사용 금지) ──
# 생성: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
MP_TOKEN_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
MP_OAUTH_STATE_SECRET=CHANGE_ME_openssl_rand_hex_32
MP_WEBHOOK_SECRET=CHANGE_ME_openssl_rand_hex_32
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# ── MinIO ─────────────────────────────────────────────────
MINIO_ROOT_USER=stageadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_min_8_chars
MINIO_BUCKET=ventago-stage

# ── 저장소 ────────────────────────────────────────────────
REPO_URL=CHANGE_ME_git@github.com:owner/repo.git
REPO_BRANCH=main
DEPLOY_DIR=/home/jhkim/ventago-stage

# ── 안전 스위치 (★ 절대 켜지 말 것 — 이유는 README 참조) ──
# 운영 데이터를 복제하므로 실제 고객 연락처가 스테이지에 들어온다.
# 아래가 하나라도 뚫리면 스테이지가 실제 고객에게 메시지/결제를 보낼 수 있다.
CRON_ENABLED=false                     # 캠페인 발송·outbox 워커 정지
MP_FORCE_SANDBOX=true                  # Mercadopago 운영 토큰 사용 금지
DISABLE_OUTBOUND_MESSAGING=true        # Telegram / Email / WhatsApp 발신 차단
