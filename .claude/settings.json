{
  "permissions": {
    "allow": [
      "Bash(kill %1)",
      "Bash(wait)",
      "Bash(nvm ls *)",
      "Bash(fnm ls *)",
      "Bash(volta list *)",
      "Read(//usr/local/Cellar/**)",
      "Read(//opt/homebrew/**)",
      "Bash(NODE_OPTIONS='' npx next dev -p 3050)",
      "Bash(git checkout *)",
      "Bash(brew install *)",
      "Bash(/usr/local/opt/node@20/bin/node -v)",
      "Bash(tee /tmp/next-dev.log)",
      "Bash(kill %1 grep -A2 \"TypeError\\\\|RangeError\\\\|SyntaxError\\\\|ReferenceError\\\\|Error:\" /tmp/next-dev.log)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3051)",
      "Bash(lsof -i :3050 -sTCP:LISTEN)",
      "Bash(lsof -i :5001 -sTCP:LISTEN)",
      "Bash(lsof -i :5002 -sTCP:LISTEN)",
      "Bash(export PATH=\"/usr/local/opt/node@18/bin:$PATH\")",
      "Bash(pkill -f \"nest start\")",
      "Bash(pkill -f \"dev:api\")",
      "Bash(pkill -f \"next dev\")",
      "Bash(pkill -f \"dev:app\")",
      "Read(//Users/marcoskim/Trabajos_Programming/ACE_online_1.0 head -30 api-ventago/src/common/logger/logger.config.ts echo --- ls ventago-app/src/pages/**)",
      "Bash(node __TRACKED_VAR__/.claude/get-shit-done/bin/gsd-tools.cjs commit 'docs\\(20\\): capture phase context' --files .planning/phases/20-nueva-venta-variation-codigo-madre-print-agent-suspender-res/20-CONTEXT.md .planning/phases/20-nueva-venta-variation-codigo-madre-print-agent-suspender-res/20-DISCUSSION-LOG.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-check-update.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-session-state.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-context-monitor.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-phase-boundary.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-progress-notify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-prompt-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-read-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-workflow-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-validate-commit.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gsd-statusline.js"
  }
}
